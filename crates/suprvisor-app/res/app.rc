// Resources of suprvisor.exe. Compiled to app.res by rc.exe (see make-icon.py); build.rs links it.
1 ICON "suprvisor.ico"

1 VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Suprvisor"
      VALUE "ProductName", "Suprvisor"
      VALUE "FileVersion", "1.2.0"
      VALUE "ProductVersion", "1.2.0"
      VALUE "OriginalFilename", "suprvisor.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
